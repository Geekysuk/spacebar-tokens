rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Rob's Firebase Auth uid
    function isAdmin() {
      return request.auth != null && request.auth.uid == "yTsmDLgPaDZBBvM5U8OrAwVy2vC2";
    }
    function staffDoc(h) { return get(/databases/$(database)/documents/staffCodes/$(h)); }
    function staffOk(h) {
      return h is string && h.size() == 64
        && exists(/databases/$(database)/documents/staffCodes/$(h))
        && staffDoc(h).data.active == true;
    }
    function machineDoc(t) { return get(/databases/$(database)/documents/machines/$(t)); }
    function machineOk(t) {
      return t is string && t.size() == 4
        && exists(/databases/$(database)/documents/machines/$(t))
        && machineDoc(t).data.active == true;
    }
    function baseOk(d) {
      return machineOk(d.tag)
        && d.machineName == machineDoc(d.tag).data.name
        && staffOk(d.staffHash)
        && d.staffName == staffDoc(d.staffHash).data.name
        && d.at == request.time;
    }

    // Manager sessions. A manager signs in anonymously, then a sessions/{uid}
    // record ties that sign-in to an active manager code. It lasts 8 hours and
    // stops working as soon as the code is disabled, removed or stops being a manager.
    function sess() { return get(/databases/$(database)/documents/sessions/$(request.auth.uid)); }
    function isManager() {
      return request.auth != null
        && exists(/databases/$(database)/documents/sessions/$(request.auth.uid))
        && sess().data.role == "manager"
        && sess().data.at + duration.value(8, 'h') > request.time
        && staffOk(sess().data.staffHash)
        && staffDoc(sess().data.staffHash).data.get('role', 'general') == "manager";
    }

    // Managers work faults: open, in progress, fixed, and back again, with a short note.
    // They are recorded by their own staff name, and they never write money fields.
    function mgrName() { return staffDoc(sess().data.staffHash).data.name; }
    function mgrFaultOk() {
      let d = request.resource.data;
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "inProgressAt", "inProgressBy", "techNote", "closedAt", "closedBy", "closeNote"])
        && d.status in ["open", "inprogress", "closed"]
        && d.get("inProgressBy", "") is string && d.get("closedBy", "") is string
        && d.get("techNote", "") is string && d.get("techNote", "").size() <= 300
        && d.get("closeNote", "") is string && d.get("closeNote", "").size() <= 300
        && (d.status != "inprogress" || (d.inProgressBy == mgrName() && d.inProgressAt == request.time))
        && (d.status != "closed" || (d.closedBy == mgrName() && d.closedAt == request.time))
        && (d.status != "open" || (d.get("inProgressBy", "") == "" && d.get("closedBy", "") == "" && d.get("inProgressAt", null) == null && d.get("closedAt", null) == null));
    }
    // The same fault fields on the status doc the staff page reads, and nothing else.
    function mgrStatusOk(tag) {
      let d = request.resource.data;
      return d.tag == tag
        && d.faultState in ["open", "inprogress", "closed"]
        && d.faultOpen == (d.faultState != "closed")
        && d.get("faultNote", "") is string && d.get("faultNote", "").size() <= 300
        && d.get("faultTechNote", "") is string && d.get("faultTechNote", "").size() <= 300
        && d.get("faultBy", "") is string && d.get("faultId", "") is string && d.get("faultTechBy", "") is string
        && (d.get("faultAt", null) == null || d.get("faultAt", null) is timestamp);
    }

    // Machines are keyed by their 4-digit code. Staff phones can look one up
    // by code (get) but never list them all.
    match /machines/{tag} {
      allow get: if true;
      allow list: if isAdmin() || isManager();
      allow write: if isAdmin();
    }

    // Staff codes are keyed by SHA-256 of the code. Public can only "get" one
    // by hash (to find the name); only Rob can list/manage them.
    match /staffCodes/{hash} {
      allow get: if true;
      allow list, write: if isAdmin();
    }

    // Staff names and on/off only, no codes. Lets managers see who logged nothing. Rob writes it.
    match /roster/{id} {
      allow read: if isAdmin() || isManager();
      allow write: if isAdmin();
    }

    match /empties/{id} {
      allow read: if isAdmin() || isManager();
      allow update, delete: if isAdmin();
      allow create: if isAdmin() || (
        request.resource.data.keys().hasOnly(["tag", "machineName", "staffHash", "staffName", "at", "tokens", "ok", "check", "note"])
        && baseOk(request.resource.data)
        && request.resource.data.tokens is int
        && request.resource.data.tokens >= 0 && request.resource.data.tokens <= 100000
        && request.resource.data.ok is bool
        && request.resource.data.check in ["ok", "bad", "skipped", "stillbroken"]
        && request.resource.data.ok == (request.resource.data.check in ["ok", "skipped"])
        && request.resource.data.note is string && request.resource.data.note.size() <= 300
      );
    }

    match /faults/{id} {
      allow read: if isAdmin() || isManager();
      allow update: if isAdmin() || (isManager() && mgrFaultOk());
      allow delete: if isAdmin();
      allow create: if isAdmin() || (
        request.resource.data.keys().hasOnly(["tag", "machineName", "staffHash", "staffName", "at", "note", "status", "emptyId"])
        && baseOk(request.resource.data)
        && request.resource.data.status == "open"
        && request.resource.data.note is string
        && request.resource.data.note.size() >= 1 && request.resource.data.note.size() <= 300
        && request.resource.data.emptyId is string
      );
    }

    // Per-machine status the staff page reads: last test + open fault.
    // Staff may record a test or raise a fault; only Rob can clear a fault.
    match /status/{tag} {
      allow get: if true;
      allow list, delete: if isAdmin();
      allow create, update: if isAdmin() || (
        request.resource.data.keys().hasOnly(["tag", "staffHash", "lastTestedAt", "lastTestedBy", "lastCheck", "faultOpen", "faultNote", "faultAt", "faultBy", "faultId", "faultState", "faultTechBy", "faultTechNote"])
        && request.resource.data.tag == tag
        && machineOk(tag)
        && staffOk(request.resource.data.staffHash)
        && request.resource.data.lastTestedBy == staffDoc(request.resource.data.staffHash).data.name
        && request.resource.data.lastTestedAt == request.time
        && request.resource.data.lastCheck in ["ok", "bad", "stillbroken"]
        && request.resource.data.faultOpen is bool
        && !(resource != null && resource.data.faultOpen == true && request.resource.data.faultOpen == false)
      );
      // Managers move a fault's state on this doc too: the same fields, nothing else.
      allow create: if isManager()
        && request.resource.data.keys().hasOnly(["tag", "faultOpen", "faultState", "faultNote", "faultAt", "faultBy", "faultId", "faultTechBy", "faultTechNote"])
        && mgrStatusOk(tag);
      allow update: if isManager()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["faultOpen", "faultState", "faultNote", "faultAt", "faultBy", "faultId", "faultTechBy", "faultTechNote"])
        && mgrStatusOk(tag);
    }

    // Sent-email log, written by the send-fault-email function (admin SDK).
    match /mail/{id} {
      allow read, write: if isAdmin();
    }

    // Technician codes (SHA-256 hash as doc id). Only Rob manages them; the
    // send-fault-email function checks them server-side with the admin SDK.
    match /techCodes/{hash} {
      allow read, write: if isAdmin();
    }

    match /weeks/{weekKey} {
      allow read: if isAdmin() || isManager();
      allow write: if isAdmin();
    }

    // Repair costs (parts and labour). Rob only. Managers see the repair history, never the money.
    match /faultCosts/{id} {
      allow read, write: if isAdmin();
    }

    // Manager sessions, created when a manager code is entered after anonymous sign-in.
    // Only the owner can read or delete their own session.
    match /sessions/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(["staffHash", "role", "at"])
        && request.resource.data.role == "manager"
        && request.resource.data.at == request.time
        && staffOk(request.resource.data.staffHash)
        && staffDoc(request.resource.data.staffHash).data.get('role', 'general') == "manager";
    }

    // Private per-machine details: photo and what Rob paid. Staff and public never read these.
    match /machineDetails/{tag} {
      allow read, write: if isAdmin();
    }

    // Private settings (value of one token in £).
    match /settings/{id} {
      allow read, write: if isAdmin();
    }
  }
}
